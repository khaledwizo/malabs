<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- الشريط العلوي: اسم التطبيق + الخيارات + ملف الذوق -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="أزياء البنات ✨"
            android:textColor="@color/accent" android:textSize="19sp" android:textStyle="bold" />
        <Button android:id="@+id/btnPanel" android:layout_width="wrap_content"
            android:layout_height="40dp" android:minWidth="0dp" android:paddingLeft="10dp"
            android:paddingRight="10dp" android:textSize="12sp" android:text="⚙️ إخفاء ▴" />
        <Button android:id="@+id/btnTaste" android:layout_width="wrap_content"
            android:layout_height="40dp" android:minWidth="0dp" android:paddingLeft="10dp"
            android:paddingRight="10dp" android:textSize="12sp" android:text="🧠 ذوقي" />
    </LinearLayout>

    <!-- لوحة الخيارات (تنطوي تلقائياً بعد البحث حتى تكبر الصورة) -->
    <LinearLayout android:id="@+id/panelOptions" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="الستايل" android:textColor="@color/label" android:textSize="12sp" android:textStyle="bold" />
                <Spinner android:id="@+id/spStyle"
                    android:layout_width="match_parent" android:layout_height="40dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="الطابع" android:textColor="@color/label" android:textSize="12sp" android:textStyle="bold" />
                <Spinner android:id="@+id/spRegion"
                    android:layout_width="match_parent" android:layout_height="40dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="الوضعية / المكان" android:textColor="@color/label" android:textSize="12sp" android:textStyle="bold" />
                <Spinner android:id="@+id/spPose"
                    android:layout_width="match_parent" android:layout_height="40dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="النمط" android:textColor="@color/label" android:textSize="12sp" android:textStyle="bold" />
                <Spinner android:id="@+id/spMode"
                    android:layout_width="match_parent" android:layout_height="40dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="العمر" android:textColor="@color/label" android:textSize="12sp" android:textStyle="bold" />
                <Spinner android:id="@+id/spAge"
                    android:layout_width="match_parent" android:layout_height="40dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="لغة البحث" android:textColor="@color/label" android:textSize="12sp" android:textStyle="bold" />
                <Spinner android:id="@+id/spLang"
                    android:layout_width="match_parent" android:layout_height="40dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- أزرار البحث -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btnSearch" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="0dp"
            android:textSize="13sp" android:text="بحث 🔍" />
        <Button android:id="@+id/btnRefresh" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="0dp"
            android:textSize="13sp" android:text="تحديث 🔄" />
        <Button android:id="@+id/btnSurprise" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="0dp"
            android:textSize="13sp" android:text="فاجئني 🎲" />
        <Button android:id="@+id/btnGrid" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="0dp"
            android:textSize="13sp" android:text="▦ شبكة" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <!-- نافذة البحث (مخفية تحت نافذة العرض) -->
        <WebView android:id="@+id/searchWeb" android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <!-- نافذة العرض: صورة وحدة أو شبكة -->
        <WebView android:id="@+id/web" android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <TextView android:id="@+id/txtCredit" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center"
        android:paddingTop="4dp" android:paddingBottom="2dp" android:textColor="@color/label"
        android:textSize="12sp" android:text="اختر الإطلالة واضغط بحث" />

    <!-- أدوات الصورة -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btnFav" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="0dp"
            android:paddingLeft="2dp" android:paddingRight="2dp"
            android:textSize="11sp" android:text="🤍 حفظ" android:enabled="false" />
        <Button android:id="@+id/btnFavs" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="0dp"
            android:paddingLeft="2dp" android:paddingRight="2dp"
            android:textSize="11sp" android:text="⭐ المفضلة" />
        <Button android:id="@+id/btnDownload" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="0dp"
            android:paddingLeft="2dp" android:paddingRight="2dp"
            android:textSize="11sp" android:text="⬇️ تنزيل" android:enabled="false" />
        <Button android:id="@+id/btnShare" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="0dp"
            android:paddingLeft="2dp" android:paddingRight="2dp"
            android:textSize="11sp" android:text="📤 مشاركة" android:enabled="false" />
        <Button android:id="@+id/btnOpen" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="0dp"
            android:paddingLeft="2dp" android:paddingRight="2dp"
            android:textSize="11sp" android:text="🌐 فتح" android:enabled="false" />
    </LinearLayout>
</LinearLayout>
