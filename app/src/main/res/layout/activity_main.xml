<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- الصف الأول: الستايل + النمط -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="الستايل" android:textStyle="bold" />
            <Spinner android:id="@+id/spStyle"
                android:layout_width="match_parent" android:layout_height="44dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="النمط" android:textStyle="bold" />
            <Spinner android:id="@+id/spMode"
                android:layout_width="match_parent" android:layout_height="44dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- الصف الثاني: الوضعية + لغة البحث -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="الوضعية / المكان" android:textStyle="bold" />
            <Spinner android:id="@+id/spPose"
                android:layout_width="match_parent" android:layout_height="44dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="لغة البحث" android:textStyle="bold" />
            <Spinner android:id="@+id/spLang"
                android:layout_width="match_parent" android:layout_height="44dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- الصف الثالث: العمر + ترتيب الصور -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="العمر" android:textStyle="bold" />
            <Spinner android:id="@+id/spAge"
                android:layout_width="match_parent" android:layout_height="44dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ترتيب الصور" android:textStyle="bold" />
            <Spinner android:id="@+id/spSort"
                android:layout_width="match_parent" android:layout_height="44dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- أزرار البحث -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btnSearch" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="بحث 🔍" />
        <Button android:id="@+id/btnRefresh" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="تحديث 🔄" />
        <Button android:id="@+id/btnSurprise" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="فاجئني 🎲" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <!-- نافذة البحث (مخفية تحت نافذة العرض) -->
        <WebView android:id="@+id/searchWeb" android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <!-- نافذة العرض: صورة وحدة فقط -->
        <WebView android:id="@+id/web" android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <TextView android:id="@+id/txtCredit" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center"
        android:paddingTop="6dp" android:text="اختر الإطلالة واضغط بحث" />

    <!-- أدوات الصورة -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btnFav" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:text="🤍 حفظ" android:enabled="false" />
        <Button android:id="@+id/btnFavs" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:text="⭐ المفضلة" />
        <Button android:id="@+id/btnShare" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:text="مشاركة" android:enabled="false" />
        <Button android:id="@+id/btnOpen" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:text="المتصفح" android:enabled="false" />
    </LinearLayout>
</LinearLayout>
